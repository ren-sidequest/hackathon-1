# Local OS/editor state
.DS_Store
Thumbs.db
.idea/
*.swp

# Credentials and local environment; examples may contain placeholders only
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key

# Common generated dependencies and output; refine after choosing the stack
node_modules/
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
dist/
build/
coverage/
.ci-results/
# Isolated, pinned historical contract checkout used only by regression CI.
/.api3-contract/
*.log
*.sqlite
*.sqlite3

# Project-local code intelligence and machine-specific Codex configuration
.gitnexus/
.codex/config.toml

# Backend SQLite sidecars and per-database local process ownership
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.sqlite.lock
*.sqlite.lock.reclaim
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal
*.sqlite3.lock
*.sqlite3.lock.reclaim

# Copy-only SQLite migration diagnostics; never publish data files.
*.sqlite.migration-*.tmp*
*.sqlite3.migration-*.tmp*
