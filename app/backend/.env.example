# Local synthetic demo only. Never use a model key in VITE_* variables.
DEMO_CONTRACT=4.0
PORT=8787
DATABASE_PATH=./var/evidencebridge-v4.sqlite
# Optional: reset is disabled until a random token of at least 24 characters is set.
DEMO_ADMIN_TOKEN=
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:4173,http://127.0.0.1:5186
# disabled | manual_simulation | live; no automatic model/simulation fallback.
ANALYSIS_MODE=disabled
OPENAI_API_KEY=
OPENAI_MODEL=
AI_TIMEOUT_MS=20000

# Existing API2 frontend: use npm run start:legacy and an explicit v2 database path.
# Additional loopback preview ports must be explicitly listed in ALLOWED_ORIGINS.
